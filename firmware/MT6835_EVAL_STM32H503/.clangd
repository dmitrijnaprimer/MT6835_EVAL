CompileFlags:
  Add:
    - "-Iopt/arm-gnu-toolchain-15.2.rel1-x86_64-arm-none-eabi/arm-none-eabi/include"
    - "-I${workspaceFolder}/Drivers/STM32F4xx_HAL_Driver/Inc"
    - "-I${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32F4xx/Include"
    - "-I${workspaceFolder}/Drivers/CMSIS/Include"
    - "-D__INT32_TYPE__=long"
    - "-D__UINT32_TYPE__=unsigned long"

Documentation:
  CommentFormat: Doxygen # Works only with clangd >= 22.0, use the snapshot version for now: https://github.com/clangd/clangd/releases